APP_ENV=production
# Blank environment values use defaults where available. Required credentials
# and origins must be populated in Vercel; this example is not a working secret file.
SERVICE_NAME=quintyne-realty-inc-backend
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/quintyne_realty_inc?retryWrites=true&w=majority
JWT_SECRET=replace-with-at-least-32-random-characters
SESSION_SECRET=replace-with-a-different-32-character-secret
FRONTEND_URL=https://app.example.com
CORS_ALLOWED_ORIGINS=https://app.example.com
TRUSTED_HOSTS=api.example.com
AUTH_COOKIE_SECURE=true
SESSION_COOKIE_SECURE=true
# Allowed values: lax, strict, none (case and surrounding whitespace are normalized).
AUTH_COOKIE_SAMESITE=none
ALLOWED_EMAIL_DOMAINS=
MAX_UPLOAD_BYTES=26214400
# Local: paddle (install requirements-local.txt); serverless: rapid.
# vercel.json sets rapid. VERCEL=1 is supplied by the platform and enables a
# writable temporary OCR model cache instead of the installed package directory.
OCR_ENGINE=paddle
GOOGLE_DRIVE_CREDENTIALS_JSON=
GOOGLE_DRIVE_ROOT_FOLDER_ID=
LOCAL_UPLOAD_DIRECTORY=uploads

# OneDrive: register a Web redirect URI matching this callback. Connect from Receipts.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=
# common supports personal and Microsoft 365 accounts; or set your tenant ID.
MICROSOFT_TENANT_ID=common

# Google Identity Services login (public Web client ID; authorize the frontend origin).
GOOGLE_OAUTH_CLIENT_ID=


# Receipt understanding: ordered failover on quota, unavailable model, or invalid extraction.
# Local PaddleOCR -> RapidOCR remains primary; these models read items and verify totals.
GEMINI_API_KEY=
GEMINI_RECEIPT_MODELS=gemini-3.1-flash-lite,gemini-3.8-flash,gemini-3.6-flash,gemini-3-flash-preview,gemini-3.5-flash-lite,gemini-2.5-flash,gemini-2.5-flash-lite
GEMINI_TIMEOUT_SECONDS=25
# Other workloads (not used for receipt extraction):
# Embeddings: Gemini Embedding 1/2. Speech: TTS models. Realtime: Live models.
# Images/video/music: Nano Banana/Veo/Lyria. Agents: Antigravity/Deep Research.
# Models with zero quota are intentionally excluded from the receipt chain.
